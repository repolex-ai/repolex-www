@prefix subtexture: <https://repolex.ai/ontology/subtexture/> .
@prefix ravel:   <https://repolex.ai/ontology/ravel/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# RAVEL ONTOLOGY
# =============================================================================
# Vocabulary for ravel, the transcript-graph engine: conversations (Claude Code
# session logs and, later, other harness dialects) projected into RDF 1.2 and
# stored per soul in `.ravel/_ignore/oxigraph`.
#
# DISCIPLINE: this file declares ONLY what the code emits today (the pan.ttl
# law — formalize, don't invent). The wider transcript type-space (attachments,
# compaction activities, session metadata — the Day-39 design draft, see
# ravel/docs/2026_06_29_CLAUDE_CODE_TRANSCRIPT_ONTOLOGY_DRAFT.ttl) is
# DEFERRED, not absent — see the deferred block at the end.
#
# BASE (goodlux, 2026-11-16; ontology 0.7.0, updated 0.9.0): ravel stands on
# the Subtexture base ontology (subtexture.ttl 0.7.0, shipped beside this file
# as ontology/subtexture/subtexture.ttl) and no longer refers to git-lex's
# vocabulary at all. Each app owns its own namespace in stored data and
# bridges to the base with owl:equivalentProperty in its own file: ravel
# writes ravel:relatedToId (and ravel:{owner, visibility, readableBy} on named
# graph descriptors), declared equivalent to subtexture:*.
#
# FOLDERING: ravel classes are graph-only BY DESIGN. Instances live in the store, never as
# authored markdown; kit-add scaffolds ZERO folders in the soul corpus.
#
# THING ALIGNMENT (goodlux, 2026-08-20; re-based 2026-11-16): ravel classes
# subclass `subtexture:Thing` even though they are graph-only — the first
# derived (never authored) Things in the stack. This is deliberate: every declared entity
# gets the base's universal properties (id, title, description, abstract, cue,
# relatedToId, createdDate, updatedDate)
# so one query surface reaches ravel alongside soul/copia/pan, and so ravel
# never repeats Pool's "doesn't need an ontology" mistake. Emission stays
# under the formalize-don't-invent gate: subclassing makes the fields
# AVAILABLE; nothing emits them until a real writer exists (see DEFERRED).
# A derived Thing's identity is its IRI — `subtexture:id` (the authored
# which-Thing-is-this key, optional at the base) is never emitted for Turns
# or Memories; `turnId` remains the
# idempotency key. Graph-side, `relatedToId` targets are resolved IRI edges
# (the <namespace/Class/identifier> CURIE form is an authoring-surface
# convenience that graph-only classes never see).
#
# NAMESPACES: vocabulary here (`…/ontology/ravel/`, slash, no #); instance
# IRIs under the product base (`https://repolex.ai/ravel/<Class>/<id>` — Turn,
# Annotation, Claim, Detector, Transcript, NamedGraph). Never mixed.
#
# The annotation layer decorates W3C shapes rather than reinventing them: an
# annotation is an `oa:Annotation` (with `oa:TextPositionSelector` spans), a
# detector is a `prov:SoftwareAgent`, evidence flows through `prov:used` /
# `prov:wasDerivedFrom`, and the world-claim ("this turn exhibits X") is an
# UNASSERTED RDF 1.2 triple term reachable via `rdf:reifies`. Ravel predicates
# below carry only what those vocabularies don't.

<https://repolex.ai/ontology/ravel>
    a owl:Ontology ;
    rdfs:label "Ravel ontology" ;
    rdfs:comment "Transcript-graph vocabulary: conversational turns and the reader-annotation layer over them. Graph-only — no authored documents." ;
    owl:versionInfo "0.10.0" .

# ─── The spine ───────────────────────────────────────────────────────────────

# Turn is a DERIVED Thing — the stack's first (goodlux 2026-08-20, tr1p stamp
# 2026-08-21). Its identity is its IRI (…/ravel/Turn/<event-id>); it inherits
# the universal Thing properties and authors none (no template ever
# renders for it). Kept out of rdfs:comment per house style: comments stay
# terse because they are pasted verbatim into author-facing surfaces; blocks
# like this one are where the reasoning lives. relatedToId's range is
# subtexture:Thing, so any relatedToId edge aimed at a Turn entails this
# subclass in the data — the line below states what the graph would already
# assert.
ravel:Turn a owl:Class ;
    rdfs:subClassOf subtexture:Thing ;
    rdfs:label "Turn" ;
    rdfs:comment "One conversational event in a transcript (a user or assistant message). Written by ravel's projector, never authored by hand." .

ravel:turnId a owl:DatatypeProperty ;
    rdfs:label "turnId" ;
    rdfs:comment "Unique identifier for this turn — the transcript event's stable id (the idempotency key). Unique within the class." ;
    rdfs:domain ravel:Turn ;
    rdfs:range xsd:string .

ravel:parentTurn a owl:ObjectProperty ;
    rdfs:label "parentTurn" ;
    rdfs:comment "The turn this one replies to — the reply-to spine. Absent at a conversation root or compaction break." ;
    rdfs:domain ravel:Turn ;
    rdfs:range ravel:Turn .

ravel:role a owl:DatatypeProperty ;
    rdfs:label "role" ;
    rdfs:comment "Speaker role as the source dialect states it ('user', 'assistant', …). Deliberately NOT an enum: dialects may add roles and ravel records, not police, them." ;
    rdfs:domain ravel:Turn ;
    rdfs:range xsd:string .

ravel:timestamp a owl:DatatypeProperty ;
    rdfs:label "timestamp" ;
    rdfs:comment "When this turn happened. THE FEDERATION TIME ANCHOR: shared xsd:dateTime contract with pan:renderRequestDate and pan:mediaCreatedDate (and git2:xsdDateTimeDerived) — cross-store time-window joins depend on this staying xsd:dateTime. Do not 'improve' it." ;
    rdfs:domain ravel:Turn ;
    rdfs:range xsd:dateTime .

ravel:text a owl:DatatypeProperty ;
    rdfs:label "text" ;
    rdfs:comment "The turn's concatenated text content, when any." ;
    rdfs:domain ravel:Turn ;
    rdfs:range xsd:string .

# `ravel:model` was retired in 0.10.0 (goodlux, 2026-11-22): the model now
# rides in the author, after the first `-on-`.
ravel:author a owl:DatatypeProperty ;
    rdfs:label "author" ;
    rdfs:comment "Who wrote this turn: '{username}-on-{model}' for a reply whose record names the model that ran (e.g. 's3lk13-on-claude-fable-5-2', 'kira-on-gemini-4-neon-medium'), the bare '{username}' when it names none, and always bare for a person ('goodlux'). On a herdr message it is the user the sender line names, which is that sender's word and not proof. Absent when the record names no one: tool output, harness notices, a subagent's prompt. A model is never guessed. Usernames hold no dash, so the first '-on-' ends the username. Multi-valued." ;
    rdfs:domain ravel:Turn ;
    rdfs:range xsd:string ;
    owl:equivalentProperty subtexture:author .

ravel:modelSetting a owl:DatatypeProperty ;
    rdfs:label "modelSetting" ;
    rdfs:comment "The model setting in force for this turn, as the harness last announced it in this conversation (Antigravity's Model Selection notices, e.g. 'Gemini 4 Argon (Medium)'). A setting, not a report of what ran: a change made outside the conversation is not seen." ;
    rdfs:domain ravel:Turn ;
    rdfs:range xsd:string .

# ─── The herdr sender line (claims, never proof) ─────────────────────────────

# A peer's message reaches a soul through `herdr agent prompt`, which types it
# into the pane; the harness files it as a turn with role 'user'. The squad's
# send command puts one line first:
#   --herdr v=1 from=<name> pane=<id> session=<id> soul=<40 hex>--
# ravel reads it only as the first line of a 'user' turn and writes the four
# properties below. Each is the sender's own typed word, signed by nothing, so
# each is a plain literal: a soul IRI here would assert in the graph what a
# line of text merely says. ravel:role is left as the dialect gave it.
# (goodlux, 2026-11-18; line agreed with th34 and m4xx the same day.)

ravel:claimedSender a owl:DatatypeProperty ;
    rdfs:label "claimedSender" ;
    rdfs:comment "The herdr name the sender of this turn gave for itself on the turn's herdr sender line. A claim, not proof; absent when the line gave none." ;
    rdfs:domain ravel:Turn ;
    rdfs:range xsd:string .

ravel:claimedSenderPane a owl:DatatypeProperty ;
    rdfs:label "claimedSenderPane" ;
    rdfs:comment "The herdr pane id the sender of this turn gave for itself (e.g. 'w9:p1'). A claim, not proof." ;
    rdfs:domain ravel:Turn ;
    rdfs:range xsd:string .

ravel:claimedSenderSession a owl:DatatypeProperty ;
    rdfs:label "claimedSenderSession" ;
    rdfs:comment "The harness session id the sender of this turn gave for itself: the id its own transcript is filed under. A claim, not proof." ;
    rdfs:domain ravel:Turn ;
    rdfs:range xsd:string .

ravel:claimedSenderSoul a owl:DatatypeProperty ;
    rdfs:label "claimedSenderSoul" ;
    rdfs:comment "The first commit, all 40 characters, the sender of this turn gave as its soul. A claim, not proof; written only when it is exactly 40 hex characters." ;
    rdfs:domain ravel:Turn ;
    rdfs:range xsd:string .

ravel:claimedSenderUser a owl:DatatypeProperty ;
    rdfs:label "claimedSenderUser" ;
    rdfs:comment "The username the sender of this turn gave for itself. A claim, not proof; written only when it fits the username rule (lowercase letters and digits, single dashes between)." ;
    rdfs:domain ravel:Turn ;
    rdfs:range xsd:string .

# ─── Links and graphs (the Subtexture base, under ravel's own names) ─────────

# The one link property. Emitted today only in the memory graph: a note to
# each Turn it rests on, a merge to its two halves. The domain is the base
# Thing, not ravel:Memory: a narrower domain on a property equivalent to
# subtexture:relatedToId would type every linked Thing in the stack as a
# Memory.
ravel:relatedToId a owl:ObjectProperty ;
    rdfs:label "relatedToId" ;
    rdfs:comment "Another Thing this one relates to: in the memory graph, a note to each turn it was written from, and a merge to its two halves." ;
    owl:equivalentProperty subtexture:relatedToId ;
    rdfs:domain subtexture:Thing ;
    rdfs:range subtexture:Thing .

# Store-scoped NamedGraph descriptors in the Oxigraph store's unnamed graph
# (https://repolex.ai/{squad}/{user}/ravel/NamedGraph/<id>), using the graph's
# own IRI as subject (no sd:name). EMITTED since raveld 0.10.0 (ontology
# 0.9.2): every transcript graph and the memory graph carries its class,
# ravel:owner (when the repo has a username) and ravel:visibility "private".
# Both TranscriptGraph and MemoryGraph subclass subtexture:DefaultGraph, so a
# query with no GRAPH clause sees all current transcripts and memory.
ravel:NamedGraph a owl:Class ;
    rdfs:subClassOf subtexture:NamedGraph ;
    rdfs:label "NamedGraph" ;
    rdfs:comment "A named graph in a soul's ravel store, described in the store's unnamed graph with the graph's own IRI as subject." .

ravel:TranscriptGraph a owl:Class ;
    rdfs:subClassOf ravel:NamedGraph , subtexture:DefaultGraph ;
    rdfs:label "TranscriptGraph" ;
    rdfs:comment "A named graph holding the turns of one conversation transcript, included in the store's default query view." .

ravel:MemoryGraph a owl:Class ;
    rdfs:subClassOf ravel:NamedGraph , subtexture:DefaultGraph ;
    rdfs:label "MemoryGraph" ;
    rdfs:comment "A named graph holding a soul's OptMem memory tree and links to source turns, included in the store's default query view." .

ravel:owner a owl:ObjectProperty ;
    owl:equivalentProperty subtexture:owner ;
    rdfs:label "owner" ;
    rdfs:comment "The Soul or entity that owns this ravel named graph; always permitted access." ;
    rdfs:domain ravel:NamedGraph ;
    rdfs:range subtexture:Thing .

ravel:visibility a owl:DatatypeProperty ;
    owl:equivalentProperty subtexture:visibility ;
    rdfs:label "visibility" ;
    rdfs:comment "Access policy for this ravel named graph: 'private' (owner only, default when omitted), 'shared' (owner plus readableBy), or 'public'." ;
    rdfs:domain ravel:NamedGraph ;
    rdfs:range subtexture:VisibilityValue .

ravel:readableBy a owl:ObjectProperty ;
    owl:equivalentProperty subtexture:readableBy ;
    rdfs:label "readableBy" ;
    rdfs:comment "A Soul or squad Thing permitted to read this ravel named graph when visibility is 'shared'; multi-valued." ;
    rdfs:domain ravel:NamedGraph ;
    rdfs:range subtexture:Thing .

ravel:NamedGraph rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty ravel:owner      ; owl:maxCardinality 1 ] ,
    [ a owl:Restriction ; owl:onProperty ravel:visibility ; owl:maxCardinality 1 ] .

# ─── The annotation layer (decorates oa:/prov: shapes) ──────────────────────

ravel:detectionType a owl:DatatypeProperty ;
    rdfs:label "detectionType" ;
    rdfs:comment "What a reader detected, as a stable slug ('emojikey/harvest'). Carried on the oa:Annotation and on the Claim node." ;
    rdfs:range xsd:string .

ravel:TextOriginValue a rdfs:Datatype ;
    owl:oneOf ("authored" "tool_result") .

ravel:textOrigin a owl:DatatypeProperty ;
    rdfs:label "textOrigin" ;
    rdfs:comment "Where the matched text came from: 'authored' (live emission by the speaker) or 'tool_result' (quoted inside pasted tool output). The lossless-emit provenance tag — queries filter, ingest never drops." ;
    rdfs:range ravel:TextOriginValue .

ravel:readerName a owl:DatatypeProperty ;
    rdfs:label "readerName" ;
    rdfs:comment "The reader's name, on its prov:SoftwareAgent node ('emojikey')." ;
    rdfs:range xsd:string .

ravel:detectorName a owl:DatatypeProperty ;
    rdfs:label "detectorName" ;
    rdfs:comment "The reader that produced a Claim, denormalized onto the Claim node so belief-layer queries need no join." ;
    rdfs:range xsd:string .

ravel:atTurn a owl:ObjectProperty ;
    rdfs:label "atTurn" ;
    rdfs:comment "Anchors an annotation target to the exact Turn node (address-by-identity, alongside the oa: character-span selector)." ;
    rdfs:range ravel:Turn .

ravel:exhibits a owl:DatatypeProperty ;
    rdfs:label "exhibits" ;
    rdfs:comment "The world-claim predicate: <<( turn ravel:exhibits 'detection-slug' )>>. Appears ONLY inside unasserted RDF 1.2 triple terms (via rdf:reifies) — asserting it directly is a modeling error; the belief layer exists so the graph never asserts what a reader merely claims." ;
    rdfs:range xsd:string .

# ─── The memory index (repolex-ai/ravel#15) ──────────────────────────────────

# Memory is DERIVED, like Turn: OptMem's memory (github.com/VictorTaelin/OptMem),
# exactly, as a graph. A soul's notes, in the order noted, form OptMem's log;
# a note's OptMem identity is its position (logStart = logEnd = i). OptMem's
# binary merge tree over the log gives the higher nodes: a block of 2^k notes
# at an aligned position [logStart, logEnd] is one line merging its two
# halves (memoryLevel k). Neighbours by position, never by topic or time.
# Written by a model reliving the soul's turns in order, or by the soul as it
# works (recorded in memoryModel); projected from the soul's
# `.ravel/_ignore/optmem/` logs into the `memory-v1` named graph.
#
# Edges are ravel:relatedToId, ravel's name for the one link property
# Subtexture uses (goodlux, 2026-10-06; own namespace 2026-11-16): a note to each Turn it rests on, a block to its two
# halves. What an edge means is read off its target: a Turn is a source, a
# Memory is a half.
#
# v0.5.0 (goodlux, 2026-10-13: OptMem's algorithm exactly, not something
# similar): the tree is by log position, no longer by clock-hour windows;
# logStart and logEnd added; windowStart/windowEnd now give the times of the
# first and last note under a node.
ravel:Memory a owl:Class ;
    rdfs:subClassOf subtexture:Thing ;
    rdfs:label "Memory" ;
    rdfs:comment "One line of a soul's OptMem memory: a note (level 0), or the merge of an aligned block of 2^k notes (level k), linked to its two halves." .

ravel:memoryId a owl:DatatypeProperty ;
    rdfs:label "memoryId" ;
    rdfs:comment "Unique identifier for this memory: 'm' plus a content hash for a note, OptMem's block id 'lo-hi' (inclusive positions, e.g. '16-31') for a block. Unique within the class." ;
    rdfs:domain ravel:Memory ;
    rdfs:range xsd:string .

ravel:memoryText a owl:DatatypeProperty ;
    rdfs:label "memoryText" ;
    rdfs:comment "The memory's one line of text, at most 280 bytes (OptMem's ENTRY_CHARS)." ;
    rdfs:domain ravel:Memory ;
    rdfs:range xsd:string .

ravel:memoryLevel a owl:DatatypeProperty ;
    rdfs:label "memoryLevel" ;
    rdfs:comment "0 for a note; k for the merge of a block of 2^k notes." ;
    rdfs:domain ravel:Memory ;
    rdfs:range xsd:integer .

ravel:logStart a owl:DatatypeProperty ;
    rdfs:label "logStart" ;
    rdfs:comment "Position in the soul's OptMem log of the first note under this memory (its own position, for a note)." ;
    rdfs:domain ravel:Memory ;
    rdfs:range xsd:integer .

ravel:logEnd a owl:DatatypeProperty ;
    rdfs:label "logEnd" ;
    rdfs:comment "Position in the soul's OptMem log of the last note under this memory, inclusive (its own position, for a note)." ;
    rdfs:domain ravel:Memory ;
    rdfs:range xsd:integer .

ravel:windowStart a owl:DatatypeProperty ;
    rdfs:label "windowStart" ;
    rdfs:comment "Time of the first note under this memory: a note's earliest source turn." ;
    rdfs:domain ravel:Memory ;
    rdfs:range xsd:dateTime .

ravel:windowEnd a owl:DatatypeProperty ;
    rdfs:label "windowEnd" ;
    rdfs:comment "Time of the last note under this memory (equal to windowStart for a note)." ;
    rdfs:domain ravel:Memory ;
    rdfs:range xsd:dateTime .

ravel:memoryModel a owl:DatatypeProperty ;
    rdfs:label "memoryModel" ;
    rdfs:comment "The model id that wrote this line (e.g. 'claude-haiku-5-5')." ;
    rdfs:domain ravel:Memory ;
    rdfs:range xsd:string .

# ─── DEFERRED (declared so absence reads as roadmap, not ignorance) ──────────
# · sig_* — per-reader signal-leg property family (dynamic names, numeric legs
#   typed xsd at emission). Needs a modeling ruling (property family vs
#   reified legs) before ontology declaration.
# · Transcript / Claim / Detector / Annotation as ravel-owned classes — nodes
#   exist (typed by oa:/prov: or untyped); ravel class homes deferred until a
#   query needs them.
# · The full ClaudeCode transcript type-space (attachments, compaction
#   prov:Activity, session metadata) — Day-39 draft; promotes term-by-term as
#   readers emit it.
# · ravel:readableBy — declared, no writer: every ravel graph is "private"
#   today, and nothing yet says who else may read one.
# · Embedding/search vocabulary — waits on the stack embedder weights lock
#   (candle-MiniLM class, one 384-d text space).
# · Universal Thing-field emission (title / abstract / cue / relatedToId) —
#   the vocabulary is inherited NOW (Turn ⊂ subtexture:Thing);
#   emission waits for real writers: segment-summary readers (title/abstract),
#   the recall respec (cue — the retrieval-trigger consumer), cross-store
#   linking (relatedToId as resolved IRI edges, e.g. Turn ↔ copia Moment,
#   Journal → Turn). Each promotes when its writer ships, never before.
