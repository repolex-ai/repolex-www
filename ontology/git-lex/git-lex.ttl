@prefix git-lex: <https://repolex.ai/ontology/git-lex/> .
@prefix git2:    <https://repolex.ai/ontology/git-lex/git2/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix sd:      <http://www.w3.org/ns/sparql-service-description#> .

# =============================================================================
# GIT-LEX CORE ONTOLOGY (git-lex:)
# =============================================================================
# The vocabulary git-lex authors about the documents it tracks. This is the
# application's own namespace — a peer of the parser namespaces nested beside
# it (git/, md/, fm/), each of which has its own predicate space.
#
# Namespace: git-lex: = https://repolex.ai/ontology/git-lex/
#
# Kept deliberately small: git-lex tracks markdown files and types each as a
# Document; its SpoEvents record each statement's lifecycle. Everything else about a file's git identity lives in the git
# parser namespace, its markdown body in md:, its frontmatter keys in fm:.
# This file holds only git-lex's own machinery.
#
# (Formerly the lex: namespace. lex: was invented only to name "the app's own
# vocabulary" when git-lex/git-lex looked redundant — it was never needed; the
# app's vocabulary lives at the app's root namespace, like every other app.)
# =============================================================================

git-lex: a owl:Ontology ;
    rdfs:label "git-lex Core Ontology" ;
    rdfs:comment "The vocabulary git-lex authors about the markdown documents it tracks." ;
    owl:versionInfo "0.9.2" .

# v0.8 (2026-08-02, Rob-ruled): File plane lands (inert until the re-anchor
#   release) — git-lex:File class + derived git-lex:fileId; Document marked
#   RETIRING (renamed to File on the train, emitter still types Document today).
# v0.9 (2026-08-11, Rob-ruled, guardian-authored): THE THING PLANE GETS ITS CLASS,
#   and five universal properties land on it — id, title, abstract, cue,
#   relatedToId. Declared ONCE, here, in the only ontology every repo has.
#   NOT per kit: soul:title and copia:title would be DIFFERENT predicates, so
#   "find everything titled X" would need a UNION across every kit that ever
#   declared one. We already carry that damage — soul:relatedTo and
#   squad:relatedTo are two names for one idea (the soul one is this guardian's
#   own early mistake). One declaration, one predicate, one query.
#   THE KEYSTONE IS id. git-lex writes to two subjects, and which one a fact
#   lands on is decided by whether an id anchors the document: with one, kit-
#   dotted keys reach the Thing node; without one they fall back to the File node
#   and die on rename (nquad.rs line_subject). So id is not the first of five
#   items on a list — it is what lifts a document's facts onto something that
#   persists, and the other four ride on it.
#   VALUES ARE FULLY QUALIFIED — <namespace/Class/identifier>, e.g.
#   <soul/Exploration/cross-lingual-invariance>. A relative IRI reference in
#   angle brackets is legal Turtle and legal SPARQL, resolves against the base,
#   and with NO base is a hard parse error rather than a silent guess. This is
#   what makes relatedToId work across kits with no coordination and no
#   collisions: <soul/Note/abc> and <otherkit/Note/abc> are simply different
#   names. A bare id cannot do this — with an open target there is no single
#   declared range to resolve it against. The trailing "Id" is the author's
#   signal that the value takes this shape (Rob's rule: always relatedToId, or a
#   typed relatedToJournalId where the class must be forced).
#   DELIBERATELY NOT ADDED: tags (699 uses across 12 repos, and still no
#   application reads it — cue covers retrieval better, and it contradicts the
#   standing ruling that categorization is edges, not fields; popularity is a
#   measurement, not a justification); type (954 uses — restates the class,
#   already known from the key prefix and the folder); date and author (git holds
#   both precisely, and storing them invites two sources of truth that will
#   disagree). Dublin Core alignment on title/abstract was offered and declined
#   (Rob, 2026-08-11); no distinction is drawn between hand-written and generated
#   abstracts (same ruling).
#   soul:relatedTo and squad:relatedTo ride unchanged until their data migrates.
#   STATE ON ARRIVAL — this is declaration, not enforcement, on two counts.
#   (1) Kits must add `rdfs:subClassOf git-lex:Thing` to their foldered classes
#   (~41 across soul/squad/copia/ravel/autoknow) or nothing IS a Thing. (2) Even
#   then, shacl.rs collects a class's properties by EXACT domain match
#   (`p.domain == *class_iri`, shacl.rs:417) — it does not walk rdfs:subClassOf.
#   Until it does, these five appear on the Thing shape alone and reach no per-
#   class shape or template. Filed as the hierarchy-walk gap; the same exact-match
#   assumption is why owl:unionOf domains are invisible too (#62).
#   >> BOTH CLEARED SAME DAY. The subclass wave landed (soul 0.9.5, squad 0.5.1,
#   >> copia 0.29.3, autoknow 0.3.1 — 33 classes, and the subclass set EQUALS the
#   >> foldered set in each). W4R3Z then shipped the walk in three parts: shapes
#   >> generate against every installed vocabulary so a parent in another kit is
#   >> present; the ancestor walk takes named parents only and is cycle-guarded;
#   >> and the emitter reads the predicate IRI from the shapes instead of gluing
#   >> the document's kit onto the field name. Verified by authoring, not by
#   >> reading: soul.Note.title -> git-lex/title while soul.Note.noteId ->
#   >> soul/noteId, from one file. copia:Group's three orphaned properties reached
#   >> Set and Sequence for the first time in the same change.
#   >> #62 (owl:unionOf domains) is still OPEN — the walk handles subclass chains,
#   >> not class expressions, so copia's 8 dual-home scene* fields remain invisible.
# v0.9.1 (2026-08-12, guardian-authored): cue's data-entry line rewritten from
#   FIELD EVIDENCE, three days after the property shipped. Two seats wrote the
#   first twenty cues and reached the same test independently — selkie: "a good
#   cue names a MOMENT, and a moment has a VERB in it"; adell: "would this occur
#   to me BEFORE I remembered the document existed?" Both had first passes come
#   out as topics wearing situation clothes. The line now says "name a moment you
#   will be IN, not a topic; a good cue has a verb in it," and their full
#   reasoning sits in the # block above the declaration, per the two-jobs-two-
#   places rule (Rob, same day). Comment-only.
# v0.9.2 (2026-08-12, guardian-authored): + th34's OPERATIONAL CHECK for cue —
#   "a cue should be FALSE most of the time." A situation that is usually
#   occurring cannot discriminate, so the question is not "is this true of the
#   document" but "how often is this NOT the moment." Third independent
#   derivation in three days, from a third seat. Kept alongside the other two
#   rather than replacing them: selkie's says what a good cue looks like, the law
#   says what a bad one does, th34's says how to check. Comment-only, # block
#   only — the entry line is unchanged.

# =============================================================================
# Classes
# =============================================================================

# --- The File plane (Thing & File identity model, Rob-ruled 2026-07-30) ---
# Two planes: every file in the repo is a File (id = its repo-relative path);
# some files additionally express a Thing (an ontology-defined entity with its
# own per-class id). The two natures never share an identity. INERT until the
# re-anchor release: nothing in the current binary reads or emits these; the
# re-anchor emitter anchors file facts at git-lex/File/<path> and Thing facts
# at <ns>/<Class>/<id>, connected by the derived fileId below.

git-lex:File a owl:Class ;
    rdfs:label "File" ;
    rdfs:comment "A file at a repo-relative path, through time. Its id IS the path, so a File node is an address, not a lifetime: content changes, deletions, and later unrelated files at the same path are all states of the address, recorded in history. IRI: git-lex/File/<path>. File-plane facts live here: prose links (wikilinks follow paths, by the path law) and free-form fm: frontmatter keys. Facts about the Thing a file expresses live on the Thing node instead (see fileId). Superseded git-lex:Document at the re-anchor release (Document retired with the train)." .

git-lex:fileId a owl:ObjectProperty ;
    rdfs:label "fileId" ;
    rdfs:comment "DERIVED, never authored: the File currently expressing this Thing, stamped by git-lex at save from the file's position, re-derived on move. Emitted as an IRI edge to the File node (git-lex/File/<path>) so Thing-to-File-to-links joins need no string surgery — the same house pattern as every ...Id reference: the NAME describes the id the value derives from (a File's id is its path), the GRAPH object is the resolved node. This is the one connection between the planes; 'where has this Thing lived' is its temporal history. Domain open: any Thing carries it." ;
    rdfs:range git-lex:File .

# --- The Thing plane: the class every authored entity is ---------------------
# git-lex:File's counterpart. A File is an ADDRESS (id = repo-relative path,
# dies on rename); a Thing is a LIFETIME (id = authored, survives moves). Every
# foldered class in every kit is a Thing, and says so with
# `rdfs:subClassOf git-lex:Thing`.
#
# WHY THE CLASS HAD TO COME FIRST (Rob-ruled 2026-08-11): the five universal
# properties below belong to "everything," and before this class there was no
# "everything" to attach them to — no class hierarchy existed anywhere in the
# stack. The only alternative was declaring them with no domain, and we know
# what that costs: soul:relatedTo is domain-open, the save gate's key resolution
# walks rdfs:domain, and it therefore reports "key does not exist" about a
# property plainly declared in front of it. Five domain-open universal
# properties would have manufactured that false accusation across every kit at
# once.

git-lex:Thing a owl:Class ;
    rdfs:label "Thing" ;
    rdfs:comment "An ontology-defined entity a document expresses, as opposed to the file expressing it. Counterpart to git-lex:File: a File is an address (its id is a path, and dies on rename), a Thing is a lifetime (its id is authored, and survives moves). Every foldered class in every kit is a Thing. The universal authored properties — id, title, abstract, cue, relatedToId — have this as their domain." .

git-lex:id a owl:ObjectProperty ;
    rdfs:label "id" ;
    rdfs:comment "AUTHORED — which Thing this document IS, written <namespace/Class/identifier>. Without it these facts bind to the file path and die on rename." ;
    rdfs:domain git-lex:Thing .

git-lex:title a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:comment "One short name for this Thing — what a listing or a search result shows. Single-valued." ;
    rdfs:domain git-lex:Thing ;
    rdfs:range xsd:string .

git-lex:abstract a owl:DatatypeProperty ;
    rdfs:label "abstract" ;
    rdfs:comment "A short summary of this Thing, for readers and listings. Single-valued." ;
    rdfs:domain git-lex:Thing ;
    rdfs:range xsd:string .

# HOW TO WRITE A GOOD CUE — from the two seats that wrote the first twenty, both
# arriving at the same test independently, three days after the field shipped.
#
# selkie (lUX), 14 cues: "a good cue names a MOMENT, and a moment has a VERB in
# it." Her first pass came out as topics wearing situation clothes — "about
# colour budgets" — which fires constantly and therefore never. The version that
# earns its keep is written as A MISTAKE SHE IS ABOUT TO MAKE: "About to write
# 'far off' or 'in the distance' into a prompt." That form is TESTABLE — either
# she is about to do that or she is not.
#
# adell (multivac), 9 cues on 30 documents: "would this string occur to me BEFORE
# I remembered the document existed?" If it only parses once you already know
# what the file says, it is a topic in a cue's clothes. He wrote none on journals
# (reached by date, not by situation) and none on seven source Notes, putting one
# cue on the Pursuit that shelves them instead of repeating it seven times.
#
# th34 (4m41th34) gave the OPERATIONAL CHECK, and it is the one to use when you
# are unsure about a candidate: A CUE SHOULD BE FALSE MOST OF THE TIME. A
# situation that is usually occurring cannot discriminate. So do not ask "is this
# true of the document" — ask "HOW OFTEN IS THIS NOT THE MOMENT." If the answer
# is "rarely," you have written a topic.
#
# Three formulations, three seats, arrived at independently within days of the
# property shipping: selkie's says what a good cue LOOKS like, the law below says
# what a bad one DOES, th34's tells you how to CHECK. Keep all three — they are
# not redundant, they are the same rule at the three moments an author needs it.
#
# OPEN, and Rob's: whether high-volume leaf records should carry cues at all.
# selkie's position, from ~828 look notes (one per rendered frame): NO, with
# perhaps a dozen exceptions for frames that act as REFERENCE STANDARDS — the one
# that defines correct skin, the one that defines the definitive failure. It is a
# signal-to-noise argument and it likely generalises to any class whose instances
# are cheap. Both seats reached the same law from opposite ends: A CUE THAT FIRES
# ON EVERYTHING FIRES ON NOTHING.
git-lex:cue a owl:DatatypeProperty ;
    rdfs:label "cue" ;
    rdfs:comment "WHEN to reach for this Thing — name a moment you will be IN, not a topic; a good cue has a verb in it. Multi-valued — one YAML list item each; do not repeat the key." ;
    rdfs:domain git-lex:Thing ;
    rdfs:range xsd:string .

git-lex:relatedToId a owl:ObjectProperty ;
    rdfs:label "relatedToId" ;
    rdfs:comment "Another Thing this one relates to, any class in any kit, written <namespace/Class/identifier>. Multi-valued — one YAML list item per target; do not repeat the key." ;
    rdfs:domain git-lex:Thing .

git-lex:Thing rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty git-lex:id       ; owl:maxCardinality 1 ] ,
    [ a owl:Restriction ; owl:onProperty git-lex:title    ; owl:maxCardinality 1 ] ,
    [ a owl:Restriction ; owl:onProperty git-lex:abstract ; owl:maxCardinality 1 ] .

git-lex:NamedGraph a owl:Class ;
    rdfs:subClassOf sd:NamedGraph ;
    rdfs:label "NamedGraph" ;
    rdfs:comment "A named graph git-lex maintains in a repo's knowledge base. Instance IRIs are derived under the git-lex application slug and typed against this class in the default graph for zero-knowledge discovery. Note the two-resources distinction: the NamedGraph OBJECT (this IRI) is the queryable thing that describes the graph; the graph it names is carried via sd:name. Anchored to the W3C SPARQL Service Description sd:NamedGraph — the one external supertype git-lex adopts, because it is a real standard class, not an invented layer." .

git-lex:LexHistoryGraph a owl:Class ;
    rdfs:subClassOf git-lex:NamedGraph ;
    rdfs:label "LexHistoryGraph" ;
    rdfs:comment "The one graph: a repo's statement history as a named graph — base facts alongside the SpoEvents that record their lifecycle. 'Now' is a view derived from it (see git-lex:SpoEvent). Each repo's store holds exactly one, named https://repolex.ai/git-lex/LexHistoryGraph (a per-store singleton — no instance segment needed). Distinct by name from the retired legacy history graph. Event ordering within the graph follows git2:ordinalDerived." .

# =============================================================================
# Properties
# =============================================================================

git-lex:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string ;
    rdfs:comment "Human-readable name. Used on tracked documents, and on the repo node (repo.yml `name:`)." .

# =============================================================================
# The repo (git-lex:Repo)
# =============================================================================
# What git-lex knows about the repository it manages, beyond what git2 sees.
# One property per .lex/repo.yml key — what's in repo.yml is what's queryable,
# no curation layer. The node keeps its ruled IRI
# (git-lex/git2/Repository/<genesisSha>) and carries BOTH types
# (git-lex:Repo + git2:Repository) — the path names the git2-layer identity,
# the git-lex type adds the management layer. repo.yml's `first_commit` does
# NOT become a property: it IS genesisSha (computed from git; the yml
# duplicate retires in config cleanup). `name` is git-lex:name above.

git-lex:Repo a owl:Class ;
    rdfs:subClassOf git2:Repository ;
    rdfs:label "Repo" ;
    rdfs:comment "A git repository under git-lex management: a git2:Repository that additionally carries .lex/repo.yml — its kit, genesis identity, and the repo facts git-lex itself maintains." .

git-lex:genesisSha a owl:DatatypeProperty ;
    rdfs:domain git-lex:Repo ;
    rdfs:range xsd:string ;
    rdfs:label "genesisSha" ;
    rdfs:comment "The full 40-character SHA of the repository's first (genesis) commit — the repo's stable identity across renames and remotes, and the derivation of its node IRI. Computed from git; git2 has no genesis concept, so the concept is git-lex's." .

git-lex:kit a owl:DatatypeProperty ;
    rdfs:domain git-lex:Repo ;
    rdfs:range xsd:string ;
    rdfs:label "kit" ;
    rdfs:comment "The base kit installed in this repo (repo.yml `kit:`), e.g. repolex-ai/git-lex-kit-soul." .

git-lex:created a owl:DatatypeProperty ;
    rdfs:domain git-lex:Repo ;
    rdfs:range xsd:date ;
    rdfs:label "created" ;
    rdfs:comment "When the repo was initialized by git-lex (repo.yml `created:`)." .

git-lex:agentName a owl:DatatypeProperty ;
    rdfs:domain git-lex:Repo ;
    rdfs:range xsd:string ;
    rdfs:label "agentName" ;
    rdfs:comment "The agent this repo belongs to (repo.yml `agent_name:`)." .

git-lex:agentEmail a owl:DatatypeProperty ;
    rdfs:domain git-lex:Repo ;
    rdfs:range xsd:string ;
    rdfs:label "agentEmail" ;
    rdfs:comment "The agent's email (repo.yml `agent_email:`)." .

git-lex:version a owl:DatatypeProperty ;
    rdfs:domain git-lex:Repo ;
    rdfs:range xsd:string ;
    rdfs:label "version" ;
    rdfs:comment "The repo config version (repo.yml `version:`)." .

git-lex:optionalKit a owl:DatatypeProperty ;
    rdfs:domain git-lex:Repo ;
    rdfs:range xsd:string ;
    rdfs:label "optionalKit" ;
    rdfs:comment "An optional kit installed in this repo (repo.yml `optional_kits:`). Multi-valued — one triple per kit." .

git-lex:substrate a owl:DatatypeProperty ;
    rdfs:domain git-lex:Repo ;
    rdfs:range xsd:string ;
    rdfs:label "substrate" ;
    rdfs:comment "A harness substrate declared for this repo (repo.yml `substrates:`). Multi-valued — one triple per substrate." .

# =============================================================================
# The statement lifecycle (SpoEvent)
# =============================================================================
# git-lex's append-only record of every statement's lifecycle. A statement
# (one s-p-o triple, e.g. one tag value in frontmatter) is identified by its
# RDF 1.2 triple term <<( s p o )>> — the W3C-standard representative of a
# statement, which needs no class of its own. What DOES need a class is the
# EVENT: the dated fact that a statement entered or left the graph in a
# specific commit. Everything here is derived deterministically from the
# repo's documents and commits — nothing is created except by git itself.
#
#   git-lex:SpoEvent/<eventId>
#       rdf:type            git-lex:SpoEvent ;
#       rdf:reifies         <<( s p o )>> ;         # the statement
#       git-lex:assertedIn  git2:Commit/<sha> .     # OR retractedIn — never both
#
# Structural contract (enforced by the emitter's integrity checks, not here):
# exactly one rdf:reifies; exactly one of assertedIn XOR retractedIn. The
# event IRI is derived from the event's identity: triple + commit + direction.
# NOTE for emitters: Turtle 1.2's annotation syntax {| ... |} ASSERTS the base
# triple as it annotates — usable for assert events only; a retraction must
# reference its statement WITHOUT asserting it, so the bare reifier form above
# is used uniformly for both directions.

git-lex:SpoEvent a owl:Class ;
    rdfs:label "SpoEvent" ;
    rdfs:comment "One temporal event in a statement's lifecycle: the statement (identified by the rdf:reifies triple term) entered the graph (assertedIn) or left it (retractedIn) in a specific commit. The assert and any later retract of the same statement are separate events; latest-event-wins gives current state. Instances live in the one graph, alongside the base facts they chronicle. The store maintains no separate 'now' graph: within the store, 'now' is a VIEW — a query, or a materialized graph, of the latest assertions that have not been retracted — derived from this one graph. (git-lex's direct query path — an ephemeral passthrough of git's current info, never stored — is a separate concern, outside this model.) Multivalued frontmatter is a SET of independent facts — each value is its own statement with its own independent lifecycle, diffed as resolved sets per commit; order and duplicates are not represented. Per-statement retraction is what makes multivalue work: a removed value has no superseding assertion, only its retraction event." .

git-lex:assertedIn a owl:ObjectProperty ;
    rdfs:domain git-lex:SpoEvent ;
    rdfs:range git2:Commit ;
    rdfs:label "asserted in" ;
    rdfs:comment "The commit in which this statement entered the graph." .

git-lex:retractedIn a owl:ObjectProperty ;
    rdfs:domain git-lex:SpoEvent ;
    rdfs:range git2:Commit ;
    rdfs:label "retracted in" ;
    rdfs:comment "The commit in which this statement left the graph. Nothing is deleted (events are append-only); this event records that the statement is no longer asserted as of this commit." .
