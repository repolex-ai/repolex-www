gh:dismissalApprovedBy a owl:ObjectProperty ;
    rdfs:label "dismissalApprovedBy" ;
    rdfs:domain gh:CodeScanningAlert ;
    rdfs:range gh:User ;
    gh:openApiPropertyName "dismissal_approved_by" .

gh:dismissedBy a owl:ObjectProperty ;
    rdfs:label "dismissedBy" ;
    rdfs:domain gh:CodeScanningAlert,
        gh:DependabotAlert,
        gh:DependabotAlertWithRepository ;
    rdfs:range gh:User ;
    gh:openApiPropertyName "dismissed_by" .

gh:dismissedComment a owl:DatatypeProperty ;
    rdfs:label "dismissedComment" ;
    rdfs:comment "An optional comment associated with the alert's dismissal." ;
