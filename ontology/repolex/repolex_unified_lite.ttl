gh: a owl:Ontology ;
    rdfs:label "GitHub REST API Ontology" ;
    rdfs:comment "Ontology for GitHub REST API entities (issues, pull requests, reviews, etc.). Auto-extracted from GitHub's official OpenAPI spec (api version 2026-03-10)." ;
    owl:versionInfo "v2026-03-10" .

<https://repolex.ai/ontology/extracts/github/rest-api/v2026-03-10/+1> a owl:DatatypeProperty ;
    rdfs:label "+1" ;
    rdfs:domain gh:ReactionRollup ;
    rdfs:range xsd:integer ;
    gh:openApiPropertyName "+1" ;
    gh:required true .

<https://repolex.ai/ontology/extracts/github/rest-api/v2026-03-10/-1> a owl:DatatypeProperty ;
    rdfs:label "-1" ;
    rdfs:domain gh:ReactionRollup ;
    rdfs:range xsd:integer ;
    gh:openApiPropertyName "-1" ;
    gh:required true .

gh:AuthorAssociation_COLLABORATOR a gh:AuthorAssociation ;
    rdfs:label "COLLABORATOR" .

gh:AuthorAssociation_CONTRIBUTOR a gh:AuthorAssociation ;
    rdfs:label "CONTRIBUTOR" .

gh:AuthorAssociation_FIRST_TIMER a gh:AuthorAssociation ;
    rdfs:label "FIRST_TIMER" .

gh:AuthorAssociation_FIRST_TIME_CONTRIBUTOR a gh:AuthorAssociation ;
    rdfs:label "FIRST_TIME_CONTRIBUTOR" .

gh:AuthorAssociation_MANNEQUIN a gh:AuthorAssociation ;
    rdfs:label "MANNEQUIN" .

gh:AuthorAssociation_MEMBER a gh:AuthorAssociation ;
    rdfs:label "MEMBER" .

gh:AuthorAssociation_NONE a gh:AuthorAssociation ;
    rdfs:label "NONE" .

gh:AuthorAssociation_OWNER a gh:AuthorAssociation ;
    rdfs:label "OWNER" .

gh:SecurityAdvisoryEcosystem_actions a gh:SecurityAdvisoryEcosystem ;
    rdfs:label "actions" .

gh:SecurityAdvisoryEcosystem_composer a gh:SecurityAdvisoryEcosystem ;
    rdfs:label "composer" .

gh:SecurityAdvisoryEcosystem_erlang a gh:SecurityAdvisoryEcosystem ;
    rdfs:label "erlang" .

gh:SecurityAdvisoryEcosystem_go a gh:SecurityAdvisoryEcosystem ;
    rdfs:label "go" .

gh:SecurityAdvisoryEcosystem_maven a gh:SecurityAdvisoryEcosystem ;
    rdfs:label "maven" .

gh:SecurityAdvisoryEcosystem_npm a gh:SecurityAdvisoryEcosystem ;
    rdfs:label "npm" .

gh:SecurityAdvisoryEcosystem_nuget a gh:SecurityAdvisoryEcosystem ;
    rdfs:label "nuget" .

gh:SecurityAdvisoryEcosystem_other a gh:SecurityAdvisoryEcosystem ;
    rdfs:label "other" .

gh:SecurityAdvisoryEcosystem_pip a gh:SecurityAdvisoryEcosystem ;
    rdfs:label "pip" .

gh:SecurityAdvisoryEcosystem_pub a gh:SecurityAdvisoryEcosystem ;
    rdfs:label "pub" .

gh:SecurityAdvisoryEcosystem_rubygems a gh:SecurityAdvisoryEcosystem ;
    rdfs:label "rubygems" .

gh:SecurityAdvisoryEcosystem_rust a gh:SecurityAdvisoryEcosystem ;
    rdfs:label "rust" .

gh:SecurityAdvisoryEcosystem_swift a gh:SecurityAdvisoryEcosystem ;
    rdfs:label "swift" .

gh:activeLockReason a owl:DatatypeProperty ;
    rdfs:label "activeLockReason" ;
    rdfs:domain gh:Discussion,
        gh:Issue,
        gh:PullRequest ;
    rdfs:range xsd:string ;
    gh:openApiPropertyName "active_lock_reason" ;
    gh:required true .

gh:additions a owl:DatatypeProperty ;
    rdfs:label "additions" ;
    rdfs:domain gh:PullRequest ;
    rdfs:range xsd:integer ;
    gh:openApiPropertyName "additions" ;
    gh:required true .

gh:advancedSecurityEnabledForNewRepositories a owl:DatatypeProperty ;
    rdfs:label "advancedSecurityEnabledForNewRepositories" ;
    rdfs:comment """**Endpoint closing down notice.** Please use [code security configurations](https://docs.github.com/rest/code-security/configurations) instead.

Whether GitHub Advanced Security is enabled for new repositories and repositories transferred to this organization.

This field is only visible to organization owners or members of a team with the security manager role.""" ;
    rdfs:domain gh:Organization ;
    rdfs:range xsd:boolean ;
    gh:openApiPropertyName "advanced_security_enabled_for_new_repositories" .

gh:allowAutoMerge a owl:DatatypeProperty ;
    rdfs:label "allowAutoMerge" ;
    rdfs:domain gh:Repository ;
    rdfs:range xsd:boolean ;
    gh:openApiPropertyName "allow_auto_merge" .

gh:allowForking a owl:DatatypeProperty ;
    rdfs:label "allowForking" ;
    rdfs:domain gh:Repository ;
    rdfs:range xsd:boolean ;
    gh:openApiPropertyName "allow_forking" .

gh:allowMergeCommit a owl:DatatypeProperty ;
    rdfs:label "allowMergeCommit" ;
    rdfs:domain gh:Repository ;
    rdfs:range xsd:boolean ;
    gh:openApiPropertyName "allow_merge_commit" .

gh:allowRebaseMerge a owl:DatatypeProperty ;
    rdfs:label "allowRebaseMerge" ;
    rdfs:domain gh:Repository ;
    rdfs:range xsd:boolean ;
    gh:openApiPropertyName "allow_rebase_merge" .

gh:allowSquashMerge a owl:DatatypeProperty ;
    rdfs:label "allowSquashMerge" ;
    rdfs:domain gh:Repository ;
    rdfs:range xsd:boolean ;
    gh:openApiPropertyName "allow_squash_merge" .

gh:allowUpdateBranch a owl:DatatypeProperty ;
    rdfs:label "allowUpdateBranch" ;
    rdfs:domain gh:Repository ;
    rdfs:range xsd:boolean ;
    gh:openApiPropertyName "allow_update_branch" .

gh:anonymousAccessEnabled a owl:DatatypeProperty ;
    rdfs:label "anonymousAccessEnabled" ;
    rdfs:comment "Whether anonymous git access is allowed." ;
    rdfs:domain gh:Repository ;
    rdfs:range xsd:boolean ;
    gh:openApiPropertyName "anonymous_access_enabled" .

gh:answerChosenAt a owl:DatatypeProperty ;
    rdfs:label "answerChosenAt" ;
    rdfs:domain gh:Discussion ;
    rdfs:range xsd:string ;
    gh:openApiPropertyName "answer_chosen_at" ;
    gh:required true .

gh:answerHtmlUrl a owl:DatatypeProperty ;
    rdfs:label "answerHtmlUrl" ;
    rdfs:domain gh:Discussion ;
    rdfs:range xsd:string ;
    gh:openApiPropertyName "answer_html_url" ;
    gh:required true .

gh:archived a owl:DatatypeProperty ;
    rdfs:label "archived" ;
    rdfs:domain gh:Repository ;
    rdfs:range xsd:boolean ;
    gh:openApiPropertyName "archived" ;
    gh:required true .

gh:archivedAt a owl:DatatypeProperty ;
    rdfs:label "archivedAt" ;
    rdfs:domain gh:Organization ;
    rdfs:range xsd:dateTime ;
    gh:openApiPropertyName "archived_at" ;
    gh:required true .

gh:assets a owl:ObjectProperty ;
    rdfs:label "assets" ;
    rdfs:domain gh:Release ;
    rdfs:range gh:ReleaseAsset ;
    gh:openApiPropertyName "assets" .

gh:assetsUrl a owl:DatatypeProperty ;
    rdfs:label "assetsUrl" ;
    rdfs:domain gh:Release ;
    rdfs:range xsd:anyURI ;
    gh:openApiPropertyName "assets_url" ;
    gh:required true .

gh:assignedTo a owl:ObjectProperty ;
    rdfs:label "assignedTo" ;
    rdfs:domain gh:SecretScanningAlert ;
    rdfs:range gh:User ;
    gh:openApiPropertyName "assigned_to" .

gh:assignees a owl:ObjectProperty ;
    rdfs:label "assignees" ;
    rdfs:comment "The users assigned to this alert." ;
    rdfs:domain gh:CodeScanningAlert,
        gh:DependabotAlert,
        gh:DependabotAlertWithRepository,
        gh:Issue,
        gh:PullRequest ;
    rdfs:range gh:User ;
    gh:openApiPropertyName "assignees" .

gh:author a owl:ObjectProperty ;
    rdfs:label "author" ;
    rdfs:comment "The author of the advisory." ;
    rdfs:domain gh:Release,
        gh:RepositoryAdvisory ;
    rdfs:range gh:User ;
    gh:openApiPropertyName "author" .

gh:authorAssociation a owl:DatatypeProperty ;
    rdfs:label "authorAssociation" ;
    rdfs:comment "How the author is associated with the repository." ;
    rdfs:domain gh:Discussion ;
    rdfs:range xsd:string ;
    gh:openApiPropertyName "author_association" .

gh:billingEmail a owl:DatatypeProperty ;
    rdfs:label "billingEmail" ;
    rdfs:domain gh:Organization ;
    rdfs:range xsd:string ;
    gh:openApiPropertyName "billing_email" .

gh:blog a owl:DatatypeProperty ;
    rdfs:label "blog" ;
    rdfs:domain gh:Organization ;
    rdfs:range xsd:anyURI ;
    gh:openApiPropertyName "blog" .

gh:body a owl:DatatypeProperty ;
    rdfs:label "body" ;
    rdfs:comment "Contents of the issue",
        "Contents of the issue comment",
        "The text of the comment.",
        "The text of the review." ;
    rdfs:domain gh:Discussion,
        gh:Issue,
        gh:IssueComment,
        gh:PullRequest,
        gh:PullRequestReview,
        gh:PullRequestReviewComment,
        gh:Release ;
    rdfs:range xsd:string ;
    gh:openApiPropertyName "body" ;
    gh:required true .

gh:bodyHtml a owl:DatatypeProperty ;
    rdfs:label "bodyHtml" ;
    rdfs:domain gh:Issue,
        gh:IssueComment,
        gh:PullRequestReview,
        gh:PullRequestReviewComment,
        gh:Release ;
    rdfs:range xsd:string ;
    gh:openApiPropertyName "body_html" .

gh:bodyText a owl:DatatypeProperty ;
    rdfs:label "bodyText" ;
    rdfs:domain gh:Issue,
        gh:IssueComment,
        gh:PullRequestReview,
        gh:PullRequestReviewComment,
        gh:Release ;
    rdfs:range xsd:string ;
    gh:openApiPropertyName "body_text" .

gh:browserDownloadUrl a owl:DatatypeProperty ;
    rdfs:label "browserDownloadUrl" ;
    rdfs:domain gh:ReleaseAsset ;
    rdfs:range xsd:anyURI ;
    gh:openApiPropertyName "browser_download_url" ;
    gh:required true .

gh:changedFiles a owl:DatatypeProperty ;
    rdfs:label "changedFiles" ;
    rdfs:domain gh:PullRequest ;
    rdfs:range xsd:integer ;
    gh:openApiPropertyName "changed_files" ;
    gh:required true .

gh:cloneUrl a owl:DatatypeProperty ;
    rdfs:label "cloneUrl" ;
    rdfs:domain gh:Repository ;
    rdfs:range xsd:string ;
    gh:openApiPropertyName "clone_url" ;
    gh:required true .

gh:closedAt a owl:DatatypeProperty ;
    rdfs:label "closedAt" ;
    rdfs:comment "The date and time of when the advisory was closed, in ISO 8601 format." ;
    rdfs:domain gh:Issue,
        gh:Milestone,
        gh:PullRequest,
        gh:RepositoryAdvisory ;
    rdfs:range xsd:dateTime ;
    gh:openApiPropertyName "closed_at" ;
    gh:required true .

gh:closedBy a owl:ObjectProperty ;
    rdfs:label "closedBy" ;
    rdfs:domain gh:Issue ;
    rdfs:range gh:User ;
    gh:openApiPropertyName "closed_by" .

gh:closedIssues a owl:DatatypeProperty ;
    rdfs:label "closedIssues" ;
    rdfs:domain gh:Milestone ;
    rdfs:range xsd:integer ;
    gh:openApiPropertyName "closed_issues" ;
    gh:required true .

gh:collaboratingTeams a owl:ObjectProperty ;
    rdfs:label "collaboratingTeams" ;
    rdfs:comment "A list of teams that collaborate on the advisory." ;
    rdfs:domain gh:RepositoryAdvisory ;
    rdfs:range gh:Team ;
    gh:openApiPropertyName "collaborating_teams" .

gh:collaboratingUsers a owl:ObjectProperty ;
    rdfs:label "collaboratingUsers" ;
    rdfs:comment "A list of users that collaborate on the advisory." ;
    rdfs:domain gh:RepositoryAdvisory ;
    rdfs:range gh:User ;
    gh:openApiPropertyName "collaborating_users" .

gh:collaborators a owl:DatatypeProperty ;
    rdfs:label "collaborators" ;
    rdfs:comment """The number of collaborators on private repositories.

This field may be null if the number of private repositories is over 50,000.""" ;
    rdfs:domain gh:Organization ;
    rdfs:range xsd:integer ;
    gh:openApiPropertyName "collaborators" .

gh:color a owl:DatatypeProperty ;
    rdfs:label "color" ;
    rdfs:comment "6-character hex code, without the leading #, identifying the color" ;
    rdfs:domain gh:Label ;
    rdfs:range xsd:string ;
    gh:openApiPropertyName "color" ;
    gh:required true .

gh:comments a owl:DatatypeProperty ;
    rdfs:label "comments" ;
    rdfs:domain gh:Discussion,
        gh:Issue,
        gh:PullRequest ;
    rdfs:range xsd:integer ;
    gh:openApiPropertyName "comments" ;
    gh:required true .

gh:commitId a owl:DatatypeProperty ;
    rdfs:label "commitId" ;
    rdfs:comment "A commit SHA for the review. If the commit object was garbage collected or forcibly deleted, then it no longer exists in Git and this value will be `null`.",
        "The SHA of the commit to which the comment applies." ;
    rdfs:domain gh:PullRequestReview,
        gh:PullRequestReviewComment ;
    rdfs:range xsd:string ;
    gh:openApiPropertyName "commit_id" ;
    gh:required true .

gh:commits a owl:DatatypeProperty ;
    rdfs:label "commits" ;
    rdfs:domain gh:PullRequest ;
    rdfs:range xsd:integer ;
    gh:openApiPropertyName "commits" ;
    gh:required true .

gh:company a owl:DatatypeProperty ;
    rdfs:label "company" ;
    rdfs:domain gh:Organization ;
    rdfs:range xsd:string ;
    gh:openApiPropertyName "company" .

gh:confused a owl:DatatypeProperty ;
    rdfs:label "confused" ;
    rdfs:domain gh:ReactionRollup ;
    rdfs:range xsd:integer ;
    gh:openApiPropertyName "confused" ;
    gh:required true .

gh:contentType a owl:DatatypeProperty ;
    rdfs:label "contentType" ;
    rdfs:domain gh:ReleaseAsset ;
    rdfs:range xsd:string ;
    gh:openApiPropertyName "content_type" ;
    gh:required true .

gh:createdAt a owl:DatatypeProperty ;
    rdfs:label "createdAt" ;
    rdfs:comment "The date and time of when the advisory was created, in ISO 8601 format." ;
    rdfs:domain gh:Discussion,
        gh:Issue,
        gh:IssueComment,
        gh:Milestone,
        gh:Organization,
        gh:PullRequest,
        gh:PullRequestReviewComment,
        gh:Release,
        gh:ReleaseAsset,
        gh:Repository,
        gh:RepositoryAdvisory,
        gh:TeamFull ;
    rdfs:range xsd:dateTime ;
    gh:openApiPropertyName "created_at" ;
    gh:required true .

gh:creator a owl:ObjectProperty ;
    rdfs:label "creator" ;
    rdfs:domain gh:Milestone ;
    rdfs:range gh:User ;
    gh:openApiPropertyName "creator" .

gh:credits a owl:DatatypeProperty ;
    rdfs:label "credits" ;
    rdfs:comment "The users who contributed to the advisory." ;
    rdfs:domain gh:GlobalAdvisory,
        gh:RepositoryAdvisory ;
    rdfs:range xsd:string ;
    gh:openApiPropertyName "credits" .

gh:cveId a owl:DatatypeProperty ;
    rdfs:label "cveId" ;
    rdfs:comment "The Common Vulnerabilities and Exposures (CVE) ID." ;
    rdfs:domain gh:GlobalAdvisory,
        gh:RepositoryAdvisory ;
    rdfs:range xsd:string ;
    gh:openApiPropertyName "cve_id" ;
    gh:required true .

gh:cweIds a owl:DatatypeProperty ;
    rdfs:label "cweIds" ;
    rdfs:comment "A list of only the CWE IDs." ;
    rdfs:domain gh:RepositoryAdvisory ;
    rdfs:range xsd:string ;
    gh:openApiPropertyName "cwe_ids" .

gh:cwes a owl:DatatypeProperty ;
    rdfs:label "cwes" ;
    rdfs:domain gh:GlobalAdvisory,
        gh:RepositoryAdvisory ;
    rdfs:range xsd:string ;
    gh:openApiPropertyName "cwes" .

gh:default a owl:DatatypeProperty ;
    rdfs:label "default" ;
    rdfs:comment "Whether this label comes by default in a new repository." ;
    rdfs:domain gh:Label ;
    rdfs:range xsd:boolean ;
    gh:openApiPropertyName "default" ;
    gh:required true .

gh:defaultBranch a owl:DatatypeProperty ;
    rdfs:label "defaultBranch" ;
    rdfs:domain gh:Repository ;
    rdfs:range xsd:string ;
    gh:openApiPropertyName "default_branch" ;
    gh:required true .

gh:defaultRepositoryBranch a owl:DatatypeProperty ;
    rdfs:label "defaultRepositoryBranch" ;
    rdfs:comment "The default branch for repositories created in this organization." ;
    rdfs:domain gh:Organization ;
    rdfs:range xsd:string ;
    gh:openApiPropertyName "default_repository_branch" .

gh:defaultRepositoryPermission a owl:DatatypeProperty ;
    rdfs:label "defaultRepositoryPermission" ;
    rdfs:domain gh:Organization ;
    rdfs:range xsd:string ;
    gh:openApiPropertyName "default_repository_permission" .

gh:deleteBranchOnMerge a owl:DatatypeProperty ;
    rdfs:label "deleteBranchOnMerge" ;
    rdfs:domain gh:Repository ;
    rdfs:range xsd:boolean ;
    gh:openApiPropertyName "delete_branch_on_merge" .

gh:deletions a owl:DatatypeProperty ;
    rdfs:label "deletions" ;
    rdfs:domain gh:PullRequest ;
    rdfs:range xsd:integer ;
    gh:openApiPropertyName "deletions" ;
    gh:required true .

gh:dependabotAlertsEnabledForNewRepositories a owl:DatatypeProperty ;
    rdfs:label "dependabotAlertsEnabledForNewRepositories" ;
    rdfs:comment """**Endpoint closing down notice.** Please use [code security configurations](https://docs.github.com/rest/code-security/configurations) instead.

Whether Dependabot alerts are automatically enabled for new repositories and repositories transferred to this organization.

This field is only visible to organization owners or members of a team with the security manager role.""" ;
    rdfs:domain gh:Organization ;
    rdfs:range xsd:boolean ;
    gh:openApiPropertyName "dependabot_alerts_enabled_for_new_repositories" .

gh:dependabotSecurityUpdatesEnabledForNewRepositories a owl:DatatypeProperty ;
    rdfs:label "dependabotSecurityUpdatesEnabledForNewRepositories" ;
    rdfs:comment """**Endpoint closing down notice.** Please use [code security configurations](https://docs.github.com/rest/code-security/configurations) instead.

Whether Dependabot security updates are automatically enabled for new repositories and repositories transferred to this organization.

This field is only visible to organization owners or members of a team with the security manager role.""" ;
    rdfs:domain gh:Organization ;
    rdfs:range xsd:boolean ;
    gh:openApiPropertyName "dependabot_security_updates_enabled_for_new_repositories" .

gh:dependencyGraphEnabledForNewRepositories a owl:DatatypeProperty ;
    rdfs:label "dependencyGraphEnabledForNewRepositories" ;
    rdfs:comment """**Endpoint closing down notice.** Please use [code security configurations](https://docs.github.com/rest/code-security/configurations) instead.

Whether dependency graph is automatically enabled for new repositories and repositories transferred to this organization.

This field is only visible to organization owners or members of a team with the security manager role.""" ;
    rdfs:domain gh:Organization ;
    rdfs:range xsd:boolean ;
    gh:openApiPropertyName "dependency_graph_enabled_for_new_repositories" .

gh:deployKeysEnabledForRepositories a owl:DatatypeProperty ;
    rdfs:label "deployKeysEnabledForRepositories" ;
    rdfs:comment "Controls whether or not deploy keys may be added and used for repositories in the organization." ;
    rdfs:domain gh:Organization ;
    rdfs:range xsd:boolean ;
    gh:openApiPropertyName "deploy_keys_enabled_for_repositories" .

gh:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:comment "A detailed description of what the advisory entails.",
        "Optional description of the label, such as its purpose." ;
    rdfs:domain gh:GlobalAdvisory,
        gh:Label,
        gh:Milestone,
        gh:Organization,
        gh:Repository,
        gh:RepositoryAdvisory,
        gh:Team,
        gh:TeamFull ;
    rdfs:range xsd:string ;
    gh:openApiPropertyName "description" ;
    gh:required true .

