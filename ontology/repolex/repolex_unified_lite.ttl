    rdfs:comment "Whether the user has direct membership in the organization." ;
    rdfs:domain gh:OrgMembership ;
    rdfs:range xsd:boolean ;
    gh:openApiPropertyName "direct_membership" .

gh:disabled a owl:DatatypeProperty ;
    rdfs:label "disabled" ;
    rdfs:comment "Returns whether or not this repository disabled." ;
