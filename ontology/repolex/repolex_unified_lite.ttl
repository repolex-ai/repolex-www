    rdfs:range xsd:anyURI ;
    gh:openApiPropertyName "discussion_url" .

gh:diskUsage a owl:DatatypeProperty ;
    rdfs:label "diskUsage" ;
    rdfs:domain gh:Organization ;
    rdfs:range xsd:integer ;
