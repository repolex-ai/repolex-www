    rdfs:range xsd:boolean ;
    gh:openApiPropertyName "disabled" ;
    gh:required true .

gh:discussionUrl a owl:DatatypeProperty ;
    rdfs:label "discussionUrl" ;
    rdfs:comment "The URL of the release discussion." ;
